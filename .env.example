# Copy this file to .env for local development (optional — the app works
# without any of this, using a built-in baseline generator).

# Any OpenAI-compatible chat-completions API key.
# Groq (recommended — fast + free tier): https://console.groq.com/keys
LLM_API_KEY=

# OpenAI-compatible base URL (no trailing /chat/completions)
#   Groq:    https://api.groq.com/openai/v1   (default)
#   OpenAI:  https://api.openai.com/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Model name for the chosen provider
#   Groq:   openai/gpt-oss-120b  (default)
#   OpenAI: gpt-4o-mini
LLM_MODEL=openai/gpt-oss-120b
